<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>DuplicateTracker</AssemblyName>
    <RootNamespace>DuplicateTracker</RootNamespace>
    <Product>DuplicateTracker</Product>
    <Company>DuplicateTracker</Company>
    <AssemblyTitle>DuplicateTracker</AssemblyTitle>
    <Description>Find files that share the same content, then review, move, or delete the extra copies.</Description>
    <Copyright>Copyright (c) 2026 Ethan</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
